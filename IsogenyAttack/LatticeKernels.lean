import IsogenyAttack.Kernels
import Mathlib.GroupTheory.Index
import Mathlib.GroupTheory.SpecificGroups.Cyclic
import Mathlib.Data.Int.ModEq
import Mathlib.Tactic

/-! The HNF codes as genuine finite-index additive subgroups of Z². -/
namespace IsogenyAttack
namespace HNF

/-- The actual lattice generated by the columns `(a,0)` and `(b,e)`. -/
def lattice (h : HNF) : AddSubgroup (ℤ × ℤ) where
  carrier := {z | ∃ u v : ℤ, z = ((h.a : ℤ)*u + (h.b : ℤ)*v, (h.e : ℤ)*v)}
  zero_mem' := ⟨0,0,by ext <;> simp⟩
  add_mem' := by
    rintro x y ⟨u,v,rfl⟩ ⟨u',v',rfl⟩
    refine ⟨u+u',v+v',?_⟩
    ext <;> simp <;> ring
  neg_mem' := by
    rintro x ⟨u,v,rfl⟩
    refine ⟨-u,-v,?_⟩
    ext <;> simp [add_comm]

@[simp] theorem mem_lattice (h : HNF) (z : ℤ × ℤ) :
    z ∈ h.lattice ↔ ∃ u v : ℤ,
      z = ((h.a : ℤ)*u + (h.b : ℤ)*v, (h.e : ℤ)*v) := Iff.rfl

/-- A complete finite rectangle of representatives for lattice cosets. -/
def representative (h : HNF) (x : Fin h.a × Fin h.e) : ℤ × ℤ := (x.1.val,x.2.val)

/-- Two points in the fundamental rectangle cannot differ by a nonzero lattice vector. -/
theorem representative_unique (h : HNF) {x y : Fin h.a × Fin h.e}
    (hxy : h.representative x - h.representative y ∈ h.lattice) : x = y := by
  obtain ⟨u,v,hv⟩ := hxy
  have hx : (x.1.val : ℤ) - y.1.val = (h.a : ℤ)*u + (h.b : ℤ)*v := congrArg Prod.fst hv
  have hy : (x.2.val : ℤ) - y.2.val = (h.e : ℤ)*v := congrArg Prod.snd hv
  have hxa : (x.1.val : ℤ) < h.a := by exact_mod_cast x.1.isLt
  have hya : (y.1.val : ℤ) < h.a := by exact_mod_cast y.1.isLt
  have hxe : (x.2.val : ℤ) < h.e := by exact_mod_cast x.2.isLt
  have hye : (y.2.val : ℤ) < h.e := by exact_mod_cast y.2.isLt
  have hv0 : v = 0 := by
    have he : (0 : ℤ) < h.e := by exact_mod_cast h.e_pos
    by_contra hv0
    rcases lt_or_gt_of_ne hv0 with hn | hp
    · have : v ≤ -1 := by omega
      nlinarith [Int.natCast_nonneg x.2.val, Int.natCast_nonneg y.2.val]
    · have : 1 ≤ v := by omega
      nlinarith [Int.natCast_nonneg x.2.val, Int.natCast_nonneg y.2.val]
  have hu0 : u = 0 := by
    have ha : (0 : ℤ) < h.a := by exact_mod_cast h.a_pos
    rw [hv0, mul_zero, add_zero] at hx
    by_contra hu0
    rcases lt_or_gt_of_ne hu0 with hn | hp
    · have : u ≤ -1 := by omega
      nlinarith [Int.natCast_nonneg x.1.val, Int.natCast_nonneg y.1.val]
    · have : 1 ≤ u := by omega
      nlinarith [Int.natCast_nonneg x.1.val, Int.natCast_nonneg y.1.val]
  apply Prod.ext <;> apply Fin.ext
  · have : (x.1.val : ℤ) = y.1.val := by simp [hu0,hv0] at hx; omega
    exact_mod_cast this
  · have : (x.2.val : ℤ) = y.2.val := by simp [hv0] at hy; omega
    exact_mod_cast this

/-- Euclidean division reduces every integral vector into the fundamental rectangle. -/
theorem exists_representative (h : HNF) (z : ℤ × ℤ) :
    ∃ x : Fin h.a × Fin h.e, z - h.representative x ∈ h.lattice := by
  let v : ℤ := z.2 / (h.e : ℤ)
  let w : ℤ := z.1 - (h.b : ℤ)*v
  have ha : (0 : ℤ) < h.a := by exact_mod_cast h.a_pos
  have he : (0 : ℤ) < h.e := by exact_mod_cast h.e_pos
  have hwa : 0 ≤ w % (h.a : ℤ) := Int.emod_nonneg _ (ne_of_gt ha)
  have hwe : 0 ≤ z.2 % (h.e : ℤ) := Int.emod_nonneg _ (ne_of_gt he)
  let x : Fin h.a := ⟨(w % (h.a : ℤ)).toNat, by
    have hh := Int.emod_lt_of_pos w ha
    omega⟩
  let y : Fin h.e := ⟨(z.2 % (h.e : ℤ)).toNat, by
    have hh := Int.emod_lt_of_pos z.2 he
    omega⟩
  refine ⟨(x,y), w / (h.a : ℤ), v, ?_⟩
  have hx : (x.val : ℤ) = w % h.a := by simp [x, hwa]
  have hy : (y.val : ℤ) = z.2 % h.e := by simp [y, hwe]
  apply Prod.ext
  · change z.1 - (x.val : ℤ) = _
    rw [hx]
    have hw := Int.emod_add_mul_ediv w (h.a : ℤ)
    dsimp [w] at hw
    nlinarith
  · change z.2 - (y.val : ℤ) = _
    rw [hy]
    have hz := Int.emod_add_mul_ediv z.2 (h.e : ℤ)
    dsimp [v]
    nlinarith

/-- The fundamental rectangle is in bijection with the genuine group quotient. -/
noncomputable def quotientEquiv (h : HNF) :
    (Fin h.a × Fin h.e) ≃ ((ℤ × ℤ) ⧸ h.lattice) :=
  Equiv.ofBijective (fun x => QuotientAddGroup.mk (h.representative x)) (by
    constructor
    · intro x y hxy
      apply h.representative_unique
      exact QuotientAddGroup.eq_iff_sub_mem.mp hxy
    · intro q
      obtain ⟨z,rfl⟩ := QuotientAddGroup.mk_surjective q
      obtain ⟨x,hx⟩ := h.exists_representative z
      exact ⟨x,(QuotientAddGroup.eq_iff_sub_mem.mpr hx).symm⟩)

/-- The index is the arithmetic degree, now proved for an actual lattice. -/
theorem lattice_index (h : HNF) : h.lattice.index = h.degree := by
  rw [AddSubgroup.index_eq_card, ← Nat.card_congr h.quotientEquiv]
  simp [Nat.card_eq_fintype_card, degree]


@[simp] theorem first_generator_mem (h : HNF) : ((h.a : ℤ),0) ∈ h.lattice :=
  ⟨1,0,by simp⟩

@[simp] theorem second_generator_mem (h : HNF) : ((h.b : ℤ),(h.e : ℤ)) ∈ h.lattice :=
  ⟨0,1,by simp⟩

lemma vertical_dvd_of_lattice_le {h k : HNF} (hle : k.lattice ≤ h.lattice) : h.e ∣ k.e := by
  obtain ⟨u,v,hv⟩ := hle k.second_generator_mem
  have he := congrArg Prod.snd hv
  have hd : (h.e : ℤ) ∣ k.e := ⟨v,he⟩
  exact_mod_cast hd

lemma horizontal_dvd_of_lattice_le {h k : HNF} (hle : k.lattice ≤ h.lattice) : h.a ∣ k.a := by
  obtain ⟨u,v,hv⟩ := hle k.first_generator_mem
  have he : (0 : ℤ) = (h.e : ℤ)*v := congrArg Prod.snd hv
  have hv0 : v = 0 := (mul_eq_zero.mp he.symm).resolve_left (by exact_mod_cast Nat.ne_of_gt h.e_pos)
  have ha : (k.a : ℤ) = (h.a : ℤ)*u := by simpa [hv0] using congrArg Prod.fst hv
  have hd : (h.a : ℤ) ∣ k.a := ⟨u,ha⟩
  exact_mod_cast hd

/-- HNF codes are equal precisely when their actual integral subgroups agree. -/
theorem lattice_injective : Function.Injective lattice := by
  intro h k heq
  have ha : h.a = k.a := Nat.dvd_antisymm
    (horizontal_dvd_of_lattice_le heq.ge) (horizontal_dvd_of_lattice_le heq.le)
  have he : h.e = k.e := Nat.dvd_antisymm
    (vertical_dvd_of_lattice_le heq.ge) (vertical_dvd_of_lattice_le heq.le)
  have hb : h.b = k.b := by
    have hmem : ((h.b : ℤ),(h.e : ℤ)) ∈ k.lattice := heq ▸ h.second_generator_mem
    obtain ⟨u,v,hv⟩ := hmem
    have hvone : v = 1 := by
      have hh : (k.e : ℤ) = (k.e : ℤ)*v := by simpa [he] using congrArg Prod.snd hv
      have hne : (k.e : ℤ) ≠ 0 := by exact_mod_cast Nat.ne_of_gt k.e_pos
      exact mul_left_cancel₀ hne (by simpa using hh.symm)
    have hh : (h.b : ℤ) = (k.a : ℤ)*u + (k.b : ℤ) := by
      simpa [hvone] using congrArg Prod.fst hv
    have hhb : (h.b : ℤ) < k.a := by exact_mod_cast (ha ▸ h.b_lt)
    have hkb : (k.b : ℤ) < k.a := by exact_mod_cast k.b_lt
    have hap : (0 : ℤ) < k.a := by exact_mod_cast k.a_pos
    have hu0 : u = 0 := by
      by_contra hu0
      rcases lt_or_gt_of_ne hu0 with hn | hp
      · have : u ≤ -1 := by omega
        nlinarith [Int.natCast_nonneg h.b,Int.natCast_nonneg k.b]
      · have : 1 ≤ u := by omega
        nlinarith [Int.natCast_nonneg h.b,Int.natCast_nonneg k.b]
    exact_mod_cast (show (h.b : ℤ) = k.b by simpa [hu0] using hh)
  exact HNF.ext ha he hb


/-- Scalar divisibility has its intrinsic lattice meaning. If `m*k` is the
index, the two k-scaled coordinate vectors lie in the lattice exactly when
m divides its scalar content. -/
theorem coordinate_multiples_mem_iff (h : HNF) {m k : ℕ}
    (hm : 0 < m) (hmk : m*k = h.degree) :
    (((k : ℤ),0) ∈ h.lattice ∧ ((0 : ℤ),(k : ℤ)) ∈ h.lattice) ↔ m ∣ h.content := by
  have ha : (h.a : ℤ) ≠ 0 := by exact_mod_cast Nat.ne_of_gt h.a_pos
  have he : (h.e : ℤ) ≠ 0 := by exact_mod_cast Nat.ne_of_gt h.e_pos
  have hmul : (m : ℤ)*(k : ℤ) = (h.a : ℤ)*(h.e : ℤ) := by exact_mod_cast hmk
  have hkpos : 0 < k := by
    have hdeg := h.degree_pos
    nlinarith
  constructor
  · rintro ⟨⟨u,v,hv⟩,⟨u',v',hv'⟩⟩
    have hv0 : v = 0 := (mul_eq_zero.mp (congrArg Prod.snd hv).symm).resolve_left he
    have hk1 : (k : ℤ) = (h.a : ℤ)*u := by simpa [hv0] using congrArg Prod.fst hv
    have hk2 : (k : ℤ) = (h.e : ℤ)*v' := congrArg Prod.snd hv'
    have hz : (0 : ℤ) = (h.a : ℤ)*u' + (h.b : ℤ)*v' := congrArg Prod.fst hv'
    have hme : (m : ℤ)*u = h.e := by
      apply mul_left_cancel₀ ha
      calc
        (h.a : ℤ)*((m : ℤ)*u) = (m : ℤ)*((h.a : ℤ)*u) := by ring
        _ = (m : ℤ)*(k : ℤ) := by rw [hk1]
        _ = _ := hmul
    have hma : (m : ℤ)*v' = h.a := by
      apply mul_left_cancel₀ he
      calc
        (h.e : ℤ)*((m : ℤ)*v') = (m : ℤ)*((h.e : ℤ)*v') := by ring
        _ = (m : ℤ)*(k : ℤ) := by rw [hk2]
        _ = _ := by rw [hmul]; ring
    have hvne : v' ≠ 0 := by
      intro hh
      have hk0 : k = 0 := by simpa [hh] using hk2
      omega
    have hzero : (m : ℤ)*u' + (h.b : ℤ) = 0 := by
      apply mul_left_cancel₀ hvne
      calc
        v' * ((m : ℤ)*u' + (h.b : ℤ)) = (h.a : ℤ)*u' + (h.b : ℤ)*v' := by rw [← hma]; ring
        _ = v'*0 := by rw [← hz]; ring
    have hda : m ∣ h.a := by exact_mod_cast (show (m : ℤ) ∣ (h.a : ℤ) from ⟨v',hma.symm⟩)
    have hde : m ∣ h.e := by exact_mod_cast (show (m : ℤ) ∣ (h.e : ℤ) from ⟨u,hme.symm⟩)
    have hdb : m ∣ h.b := by
      exact_mod_cast (show (m : ℤ) ∣ (h.b : ℤ) from ⟨-u',by nlinarith⟩)
    exact Nat.dvd_gcd hda (Nat.dvd_gcd hde hdb)
  · intro hdiv
    obtain ⟨A,hA⟩ := (Nat.dvd_gcd_iff.mp hdiv).1
    obtain ⟨E,hE⟩ := (Nat.dvd_gcd_iff.mp (Nat.dvd_gcd_iff.mp hdiv).2).1
    obtain ⟨T,hT⟩ := (Nat.dvd_gcd_iff.mp (Nat.dvd_gcd_iff.mp hdiv).2).2
    have hk : k = m*A*E := by
      apply Nat.eq_of_mul_eq_mul_left hm
      rw [hmk,degree,hA,hE]
      ring
    constructor
    · refine ⟨(E : ℤ),0,?_⟩
      ext <;> simp [hA,hk]
    · refine ⟨-(T : ℤ),(A : ℤ),?_⟩
      ext <;> simp [hA,hE,hT,hk] <;> ring

end HNF

/-- Every additive subgroup of the integers consists of the multiples of one
nonnegative integer. This is proved from cyclicity, not assumed as an HNF axiom. -/
theorem int_subgroup_multiples (S : AddSubgroup ℤ) :
    ∃ a : ℕ, ∀ z : ℤ, z ∈ S ↔ (a : ℤ) ∣ z := by
  obtain ⟨g,hg⟩ := IsAddCyclic.exists_generator (α := S)
  refine ⟨g.val.natAbs, ?_⟩
  intro z
  rw [Int.natAbs_dvd]
  constructor
  · intro hz
    obtain ⟨k,hk⟩ := hg ⟨z,hz⟩
    refine ⟨k, ?_⟩
    have hk' := congrArg Subtype.val hk
    simpa [zsmul_eq_mul,mul_comm] using hk'.symm
  · rintro ⟨k,rfl⟩
    simpa [zsmul_eq_mul,mul_comm] using S.zsmul_mem g.property k

/-- Every finite-index integral subgroup of rank two has an HNF code. -/
theorem exists_hnf_of_index_ne_zero (S : AddSubgroup (ℤ × ℤ)) (hS : S.index ≠ 0) :
    ∃ h : HNF, h.lattice = S := by
  let horizontal := S.comap (AddMonoidHom.inl ℤ ℤ)
  let vertical := S.map (AddMonoidHom.snd ℤ ℤ)
  obtain ⟨a,ha⟩ := int_subgroup_multiples horizontal
  obtain ⟨e,he⟩ := int_subgroup_multiples vertical
  have ha0 : 0 < a := by
    have hn : (S.index : ℤ) ∈ horizontal := by
      simpa [horizontal] using S.nsmul_index_mem ((1 : ℤ),0)
    have hd := (ha (S.index : ℤ)).mp hn
    have hd' : a ∣ S.index := by exact_mod_cast hd
    exact Nat.pos_of_dvd_of_pos hd' (Nat.pos_of_ne_zero hS)
  have he0 : 0 < e := by
    have hn : (S.index : ℤ) ∈ vertical := by
      refine ⟨((0 : ℤ),(S.index : ℤ)), ?_, rfl⟩
      simpa using S.nsmul_index_mem ((0 : ℤ),1)
    have hd := (he (S.index : ℤ)).mp hn
    have hd' : e ∣ S.index := by exact_mod_cast hd
    exact Nat.pos_of_dvd_of_pos hd' (Nat.pos_of_ne_zero hS)
  have ha_mem : ((a : ℤ),0) ∈ S := (ha (a : ℤ)).mpr (dvd_refl _)
  have he_mem : (e : ℤ) ∈ vertical := (he (e : ℤ)).mpr (dvd_refl _)
  obtain ⟨z,hz,hze⟩ := he_mem
  change z.2 = (e : ℤ) at hze
  let b : ℕ := (z.1 % (a : ℤ)).toNat
  have hapos : (0 : ℤ) < a := by exact_mod_cast ha0
  have hrem := Int.emod_nonneg z.1 (ne_of_gt hapos)
  have hb : b < a := by
    have hlt := Int.emod_lt_of_pos z.1 hapos
    dsimp [b]
    omega
  have hbc : (b : ℤ) = z.1 % a := by simp [b,hrem]
  have hb_mem : ((b : ℤ),(e : ℤ)) ∈ S := by
    have hh := S.sub_mem hz (S.zsmul_mem ha_mem (z.1 / (a : ℤ)))
    have hid := Int.emod_add_mul_ediv z.1 (a : ℤ)
    convert hh using 1
    apply Prod.ext
    · change (b : ℤ) = z.1 - (z.1 / (a : ℤ)) * (a : ℤ)
      rw [hbc]
      nlinarith
    · simpa using hze.symm
  let h : HNF := ⟨a,e,b,ha0,he0,hb⟩
  refine ⟨h, ?_⟩
  apply le_antisymm
  · intro x hx
    obtain ⟨u,v,rfl⟩ := hx
    have hh := S.add_mem (S.zsmul_mem ha_mem u) (S.zsmul_mem hb_mem v)
    simpa [h,zsmul_eq_mul,mul_comm] using hh
  · intro x hx
    have hxv : x.2 ∈ vertical := ⟨x,hx,rfl⟩
    obtain ⟨v,hv⟩ := (he x.2).mp hxv
    have hxsub : (x.1 - (b : ℤ)*v,0) ∈ S := by
      have hh := S.sub_mem hx (S.zsmul_mem hb_mem v)
      convert hh using 1
      apply Prod.ext
      · simp [mul_comm]
      · change (0 : ℤ) = x.2 - v * (e : ℤ)
        rw [hv]; ring
    obtain ⟨u,hu⟩ := (ha _).mp hxsub
    refine ⟨u,v,?_⟩
    apply Prod.ext
    · change x.1 = (a : ℤ)*u + (b : ℤ)*v
      linarith
    · exact hv

/-- The classification is unique as an equality of actual lattices. -/
theorem existsUnique_hnf_of_index_ne_zero (S : AddSubgroup (ℤ × ℤ)) (hS : S.index ≠ 0) :
    ∃! h : HNF, h.lattice = S := by
  obtain ⟨h,hh⟩ := exists_hnf_of_index_ne_zero S hS
  exact ⟨h,hh, fun k hk => HNF.lattice_injective (hk.trans hh.symm)⟩


/-- Index-d subgroups, with their full group-theoretic meaning. -/
abbrev IndexLattice (d : ℕ) := {S : AddSubgroup (ℤ × ℤ) // S.index = d}

/-- Classification at one fixed positive index. -/
noncomputable def degreeLatticeEquiv (d : ℕ) (hd : 0 < d) :
    {h : HNF // h.degree = d} ≃ IndexLattice d :=
  Equiv.ofBijective (fun h => ⟨h.val.lattice, h.val.lattice_index.trans h.property⟩) (by
    constructor
    · intro h k heq
      exact Subtype.ext (HNF.lattice_injective (congrArg Subtype.val heq))
    · intro S
      have hS : S.val.index ≠ 0 := by rw [S.property]; omega
      obtain ⟨h,hh⟩ := exists_hnf_of_index_ne_zero S.val hS
      have hdeg : h.degree = d := by rw [← h.lattice_index,hh,S.property]
      exact ⟨⟨h,hdeg⟩,Subtype.ext hh⟩)

noncomputable instance indexLatticeFintype (d : ℕ) [hd : Fact (0 < d)] :
    Fintype (IndexLattice d) := Fintype.ofEquiv _ (degreeLatticeEquiv d hd.out)

/-- The divisor-sum count for genuine index-d integral subgroups. -/
theorem indexLattice_card (d : ℕ) (hd : 0 < d) :
    Nat.card (IndexLattice d) = kernelCount d := by
  rw [← Nat.card_congr (degreeLatticeEquiv d hd), Nat.card_eq_fintype_card, degree_card]

end IsogenyAttack
