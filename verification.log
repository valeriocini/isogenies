IsogenyAttack.attack_correct.{u_1, u_2} {α : Type u_1} {τ : Type u_2} [Fintype α] [Fintype τ] {B s : ℕ}
  (S : IsogenyAttack.FiniteLaw α) (target : α → τ) (codomain : IsogenyAttack.HNF → τ)
  (componentS : α → Option IsogenyAttack.HNF) (observedU : IsogenyAttack.BoundedKernel B → Option ℕ) (p : ℝ)
  (hs : 784 ≤ s) (hp : 49 ≤ p) (hB : 8 * s ^ 2 ≤ B) (hcut : ↑B ^ 2 < 4 * p)
  (htarget : ∀ (x : α) (k : IsogenyAttack.HNF), componentS x = some k → target x = codomain k)
  (hpoint : ∀ (t : τ), (S.eventMass fun x => target x = t) ≤ 12 / (p - 1))
  (hobserved : ∀ (k : IsogenyAttack.BoundedKernel B), (↑k).degree < B → observedU k = some (↑k).cyclicDegree) :
  1 / (1024 * ↑s ^ 3) ≤
    |((IsogenyAttack.printedLaw B ⋯).eventMass fun k => IsogenyAttack.publicTest B s (observedU k) = true) -
        S.eventMass fun x => IsogenyAttack.publicTest B s (Option.map IsogenyAttack.HNF.degree (componentS x)) = true|
IsogenyAttack.ArithmeticAttack.finite_attack_certificate.{u_1, u_2} {K : Type u_1} {ι : Type u_2} [Field K]
  [DecidableEq K] [IsAlgClosed K] [Fintype ι] (P : IsogenyAttack.FiniteLaw ι) (p : ℕ) [CharP K p] [Fact (Nat.Prime p)]
  {B s : ℕ} (hs : 784 ≤ s) (hp : 49 ≤ p) (hB : 8 * s ^ 2 ≤ B) (hcut : ↑B ^ 2 < 4 * ↑p)
  (codomain : ι → IsogenyAttack.HNF → IsogenyAttack.Legendre.HasseJClass ((p - 1) / 2)) :
  1 / (1024 * ↑s ^ 3) ≤
      IsogenyAttack.ArithmeticAttack.signedGap P (IsogenyAttack.Legendre.hasseInvariantLaw p ⋯) B s ⋯ codomain ∧
    (∀ (k : IsogenyAttack.BoundedKernel B),
        (IsogenyAttack.ArithmeticAttack.decision B s (IsogenyAttack.ArithmeticAttack.degreeObservation k)).work ≤
          8192 * (2 * B.size + s.size + 1) ^ 2 + 1) ∧
      ∀ (i : ι) (x : IsogenyAttack.TargetOutcome B (codomain i)),
        (IsogenyAttack.ArithmeticAttack.decision B s
              (Option.map IsogenyAttack.HNF.degree (IsogenyAttack.targetComponent x))).work ≤
          8192 * (2 * B.size + s.size + 1) ^ 2 + 1
IsogenyAttack.ArithmeticAttack.family_attack_certificate.{u_1, u_2} (K : ℕ → Type u_1) [(n : ℕ) → Field (K n)]
  [(n : ℕ) → DecidableEq (K n)] [∀ (n : ℕ), IsAlgClosed (K n)] (ι : ℕ → Type u_2) [(n : ℕ) → Fintype (ι n)]
  (p B : ℕ → ℕ) [∀ (n : ℕ), CharP (K n) (p n)] [∀ (n : ℕ), Fact (Nat.Prime (p n))] (hp : ∀ (n : ℕ), 49 ≤ p n)
  (hB : ∀ (n : ℕ), 8 * (n + 784) ^ 2 ≤ B n) (P : (n : ℕ) → IsogenyAttack.FiniteLaw (ι n))
  (codomain : (n : ℕ) → ι n → IsogenyAttack.HNF → IsogenyAttack.Legendre.HasseJClass ((p n - 1) / 2))
  (hparameters : ∃ N, ∀ n ≥ N, ↑(B n) ^ 2 < 4 * ↑(p n) ∧ (p n).size ≤ n) :
  (¬IsogenyAttack.IsNegligible fun n => |IsogenyAttack.ArithmeticAttack.familySignedGap K ι p B hp hB P codomain n|) ∧
    ∃ N,
      ∀ n ≥ N,
        (∀ (k : IsogenyAttack.BoundedKernel (B n)),
            (IsogenyAttack.ArithmeticAttack.decision (B n) (n + 784)
                  (IsogenyAttack.ArithmeticAttack.degreeObservation k)).work ≤
              8192 * (3 * n + 787) ^ 2 + 1) ∧
          ∀ (i : ι n) (x : IsogenyAttack.TargetOutcome (B n) (codomain n i)),
            (IsogenyAttack.ArithmeticAttack.decision (B n) (n + 784)
                  (Option.map IsogenyAttack.HNF.degree (IsogenyAttack.targetComponent x))).work ≤
              8192 * (3 * n + 787) ^ 2 + 1
IsogenyAttack.elliptic_scalar_stripping.{u_1} {K : Type u_1} [Field K] [NeZero 2] [IsAlgClosed K]
  {W : WeierstrassCurve.Affine K} [WeierstrassCurve.IsElliptic W] (ha₁ : W.a₁ = 0) (ha₃ : W.a₃ = 0) {d : ℕ}
  (hd : ↑d ≠ 0) (S : AddSubgroup W.Point) (hS : Nat.card ↥S = d) :
  ∃ m c,
    0 < m ∧
      0 < c ∧
        d = m ^ 2 * c ∧
          AddSubgroup.torsionBy W.Point ↑m ≤ S ∧
            (∀ (r : ℕ), 0 < r → r ∣ d → (AddSubgroup.torsionBy W.Point ↑r ≤ S ↔ r ∣ m)) ∧
              Nat.card ↥(AddSubgroup.map (nsmulAddMonoidHom m) S) = c ∧
                IsAddCyclic ↥(AddSubgroup.map (nsmulAddMonoidHom m) S)
IsogenyAttack.actual_hasse_samplers_attack.{u_1} {K : Type u_1} [Field K] [NeZero 2] [IsAlgClosed K]
  {W : WeierstrassCurve.Affine K} [WeierstrassCurve.IsElliptic W] (p : ℕ) [CharP K p] [Fact (Nat.Prime p)]
  (ha₁ : W.a₁ = 0) (ha₃ : W.a₃ = 0) {B s : ℕ} (hs : 784 ≤ s) (hp : 49 ≤ p) (hB : 8 * s ^ 2 ≤ B) (hcut : ↑B ^ 2 < 4 * ↑p)
  (codomain : AddSubgroup W.Point → IsogenyAttack.Legendre.HasseJClass ((p - 1) / 2)) :
  have hdeg := ⋯;
  1 / (1024 * ↑s ^ 3) ≤
    |IsogenyAttack.actualPrintedAcceptance ha₁ ha₃ B hdeg ⋯ s -
        IsogenyAttack.actualTargetAcceptance (IsogenyAttack.Legendre.hasseInvariantLaw p ⋯) ha₁ ha₃ B hdeg codomain s|
